generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Destination {
  id            Int                  @id @default(autoincrement())
  name          String               @unique
  country       String
  slug          String               @unique
  description   String?
  coverImageId  Int?
  coverImage    Image?               @relation("DestinationCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  latitude      Float?
  longitude     Float?
  viewport      Json?
  bounds        Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  images        DestinationImage[]
  featuredEntry FeaturedDestination?
  places        Place[]
  seasonalTips  SeasonalTipAiGen[]

  @@index([name])
  @@index([coverImageId])
}

model Image {
  id                Int                @id @default(autoincrement())
  url               String
  altText           String?
  photographer      String?
  photographerUrl   String?
  sourceUrl         String?
  createdAt         DateTime           @default(now())
  destinationImages DestinationImage[]
  destinationCovers Destination[]      @relation("DestinationCover")
  placeCovers       Place[]            @relation("PlaceCover")
}

model DestinationImage {
  destinationId Int
  imageId       Int
  position      Int         @default(0)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  image         Image       @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([destinationId, imageId])
  @@index([destinationId])
  @@index([imageId])
}

model Category {
  id     Int             @id @default(autoincrement())
  name   String          @unique
  slug   String          @unique
  icon   String?
  places PlaceCategory[]
}

model Place {
  id                   Int                @id @default(autoincrement())
  name                 String
  slug                 String
  address              String?
  latitude             Float?
  longitude            Float?
  website              String?
  phone                String?
  priceRange           PriceRange?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  coverImageUrl        String?
  coverImageId         Int?
  coverImage           Image?             @relation("PlaceCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  destinationId        Int
  accessibilityOptions Json?
  openingHours         Json?
  reservable           Boolean?
  featuredEntry        FeaturedPlace?
  photos               Photo[]
  destination          Destination        @relation(fields: [destinationId], references: [id])
  aiGenData            PlaceAiGenData?
  categories           PlaceCategory[]
  moods                PlaceMood[]
  reviews              Review[]
  seasonalTips         SeasonalTipAiGen[]

  @@unique([destinationId, name])
  @@unique([destinationId, slug])
  @@index([destinationId])
  @@index([coverImageId])
}

model PlaceAiGenData {
  id                             Int                @id @default(autoincrement())
  placeId                        Int                @unique
  tagline                        String?
  taglineConfidence              ConfidenceLevel?
  description                    String?
  descriptionConfidence          ConfidenceLevel?
  whyVisit                       String[]           @default([])
  whyVisitConfidence             ConfidenceLevel?
  neighbourhood                  String?
  neighbourhoodConfidence        ConfidenceLevel?
  bookingRequired                Boolean?
  bookingRequiredConfidence      ConfidenceLevel?
  bookInAdvanceWarning           String?
  bookInAdvanceWarningConfidence ConfidenceLevel?
  dressCode                      String?
  dressCodeConfidence            ConfidenceLevel?
  localTips                      String[]           @default([])
  localTipsConfidence            ConfidenceLevel?
  whatToBring                    String[]           @default([])
  whatToBringConfidence          ConfidenceLevel?
  indoorOutdoor                  IndoorOutdoor?
  indoorOutdoorConfidence        ConfidenceLevel?
  weatherDependent               Boolean?
  weatherDependentConfidence     ConfidenceLevel?
  moodsConfidence                ConfidenceLevel?
  generatedAt                    DateTime?
  modelVersion                   String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @default(now()) @updatedAt
  visitDuration                  VisitDurationEnum?
  visitDurationConfidence        ConfidenceLevel?
  place                          Place              @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model PlaceCategory {
  placeId    Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  place      Place    @relation(fields: [placeId], references: [id])

  @@id([placeId, categoryId])
  @@index([categoryId])
}

model Mood {
  id     Int         @id @default(autoincrement())
  name   String      @unique
  slug   String      @unique
  icon   String?
  places PlaceMood[]
}

model PlaceMood {
  placeId Int
  moodId  Int
  mood    Mood  @relation(fields: [moodId], references: [id])
  place   Place @relation(fields: [placeId], references: [id])

  @@id([placeId, moodId])
  @@index([moodId])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  photos       Photo[]
  reviews      Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  placeId   Int
  place     Place    @relation(fields: [placeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, placeId])
  @@index([placeId])
  @@index([userId])
}

model Photo {
  id        Int      @id @default(autoincrement())
  url       String
  caption   String?
  createdAt DateTime @default(now())
  placeId   Int
  userId    Int?
  place     Place    @relation(fields: [placeId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([placeId])
  @@index([userId])
}

model SeasonalTipAiGen {
  id            Int          @id @default(autoincrement())
  label         String
  reason        String
  avoid         Boolean      @default(false)
  placeId       Int?
  destinationId Int?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  place         Place?       @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@index([destinationId])
}

model FeaturedPlace {
  id       Int   @id @default(autoincrement())
  placeId  Int   @unique
  position Int
  place    Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([position])
}

model FeaturedDestination {
  id            Int         @id @default(autoincrement())
  destinationId Int         @unique
  position      Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([position])
}

enum PriceRange {
  FREE
  BUDGET
  MODERATE
  EXPENSIVE
  VERY_EXPENSIVE
}

enum Role {
  USER
  ADMIN
}

enum IndoorOutdoor {
  INDOOR
  OUTDOOR
  BOTH
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum VisitDurationEnum {
  UNDER_1_HOUR
  ONE_TO_TWO_HOURS
  TWO_TO_FOUR_HOURS
  HALF_DAY
  FULL_DAY
}
